<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="20dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Numbered Tile (e.g. 01, 02) -->
        <TextView
            android:id="@+id/tvTaskNumber"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_pill_button"
            android:backgroundTint="@color/primary_tint"
            android:text="01"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Title & Category Pill -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvTaskTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Early Morning Waking Up"
                android:textColor="@color/text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTaskCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Health"
                android:textColor="@color/secondary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:background="@drawable/bg_pill_button"
                android:backgroundTint="@color/secondary_tint"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- Custom Interactive Checkbox -->
        <CheckBox
            android:id="@+id/cbTaskCompleted"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:button="@drawable/checkbox_selector"
            android:background="@color/transparent" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
